{
  "name": "fieldbase-ai-sp-kit",
  "version": "0.2.0",
  "description": "Model-agnostic authoring reference + standalone style linter for Fieldbase Survey DSL (AI survey-programmer kit).",
  "license": "MIT",
  "homepage": "https://thefieldbase.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inginit/fieldbase-ai-sp-kit.git"
  },
  "bin": {
    "survey-dsl-lint": "lint/survey-dsl-lint.js"
  },
  "scripts": {
    "lint": "node lint/survey-dsl-lint.js",
    "lint:examples": "node lint/survey-dsl-lint.js examples/*.yml",
    "lint:py": "python3 lint/survey_dsl_lint.py",
    "build:bundles": "bash scripts/build-bundles.sh"
  },
  "files": [
    "SURVEY-DSL-AUTHORING.md",
    "lint/",
    "examples/",
    "bundles/",
    "integrations/",
    "scripts/",
    "LICENSE",
    "README.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "dependencies": {}
}
